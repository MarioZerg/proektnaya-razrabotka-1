{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get order without orderNumber fails",
      "method": "GET",
      "path": "/",
      "expectedStatus": 400
    },
    {
      "name": "Get non-existing order fails",
      "method": "GET",
      "path": "/?orderNumber=NON-EXISTING-999",
      "expectedStatus": 404
    },
    {
      "name": "Close order without orderId fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "close_order"
      },
      "expectedStatus": 400
    },
    {
      "name": "Repack done without newBag fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "repack_done",
        "id": 999999,
        "outcome": "repacked"
      },
      "expectedStatus": 400
    },
    {
      "name": "Repack utilized without note fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "repack_done",
        "id": 999999,
        "outcome": "utilized"
      },
      "expectedStatus": 400
    },
    {
      "name": "Repack scan without barcode fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "repack_scan"
      },
      "expectedStatus": 400
    },
    {
      "name": "Repack count works",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "repack_count",
        "workshopId": 1
      },
      "expectedStatus": 200
    },
    {
      "name": "Неизвестный исход перепаковки отклоняется",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "repack_done",
        "id": 999999,
        "outcome": "steal",
        "newBag": true
      },
      "expectedStatus": 400
    },
    {
      "name": "Перепаковка несуществующей вещи возвращает 404",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "repack_done",
        "id": 999999999,
        "outcome": "repacked",
        "newBag": true
      },
      "expectedStatus": 404
    },
    {
      "name": "Скан на перепаковку по неизвестному коду возвращает 404",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "repack_scan",
        "barcode": "QA-NO-SUCH-RETURN-CODE",
        "workshopId": 1
      },
      "expectedStatus": 404
    },
    {
      "name": "SQL-инъекция в скане перепаковки безопасна",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "repack_scan",
        "barcode": "' OR 1=1--",
        "workshopId": 1
      },
      "expectedStatus": 404
    },
    {
      "name": "SQL-инъекция в номере заказа безопасна",
      "method": "GET",
      "path": "/?orderNumber=%27%20OR%201%3D1--",
      "expectedStatus": 404
    }
  ]
}