{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Unknown action fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "nope"},
      "expectedStatus": 400
    },
    {
      "name": "GET not allowed",
      "method": "GET",
      "path": "/",
      "expectedStatus": 405
    },
    {
      "name": "Import without auth is rejected",
      "method": "POST",
      "path": "/",
      "body": {"action": "import_composition"},
      "expectedStatus": 401
    },
    {
      "name": "Close boxes without auth is rejected",
      "method": "POST",
      "path": "/",
      "body": {"action": "close_boxes", "supplyId": 1},
      "expectedStatus": 401
    },
    {
      "name": "List applications without auth is rejected",
      "method": "POST",
      "path": "/",
      "body": {"action": "list_applications"},
      "expectedStatus": 401
    }
  ]
}