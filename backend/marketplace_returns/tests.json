{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get returns list",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Approve requires admin role",
      "method": "POST",
      "path": "/",
      "body": { "action": "approve", "id": 1, "actorRole": "storekeeper" },
      "expectedStatus": 403
    },
    {
      "name": "Scan without code fails",
      "method": "POST",
      "path": "/",
      "body": { "action": "scan" },
      "expectedStatus": 400
    },
    {
      "name": "Scan unknown code fails",
      "method": "POST",
      "path": "/",
      "body": { "action": "scan", "code": "NOPE-999999" },
      "expectedStatus": 404
    },
    {
      "name": "Process without outcome fails",
      "method": "POST",
      "path": "/",
      "body": { "action": "process", "id": 1 },
      "expectedStatus": 400
    },
    {
      "name": "Unknown action fails",
      "method": "POST",
      "path": "/",
      "body": { "action": "nope" },
      "expectedStatus": 400
    }
  ]
}
