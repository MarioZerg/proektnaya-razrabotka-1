{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get rolls list",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Roll detail not found",
      "method": "GET",
      "path": "/?id=999999999",
      "expectedStatus": 404
    },
    {
      "name": "Создание рулона без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": { "action": "create" },
      "expectedStatus": 401
    },
    {
      "name": "Роль admin в теле запроса больше не даёт прав",
      "method": "POST",
      "path": "/",
      "body": { "action": "create", "actorRole": "admin", "barcode": "HACK-1", "materialId": 1, "initialQuantity": 100 },
      "expectedStatus": 401
    },
    {
      "name": "Списание материала без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": { "action": "write_off", "id": 1, "quantity": 10, "actorId": 1 },
      "expectedStatus": 401
    },
    {
      "name": "Чужой actorId в теле запроса не даёт списать материал",
      "method": "POST",
      "path": "/",
      "body": { "action": "write_off", "id": 1, "quantity": 10, "actorId": 10, "reason": "подмена" },
      "expectedStatus": 401
    },
    {
      "name": "Удаление рулона без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": { "action": "delete", "id": 1 },
      "expectedStatus": 401
    },
    {
      "name": "Закрытие рулона без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": { "action": "close_roll", "id": 1, "shortage": 0 },
      "expectedStatus": 401
    },
    {
      "name": "Начисление штрафа без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": { "action": "charge_penalty", "id": 1 },
      "expectedStatus": 401
    },
    {
      "name": "Возврат на рулон без вещи запрещён (метраж нельзя рисовать)",
      "method": "POST",
      "path": "/",
      "body": { "action": "packer_return", "barcode": "QA-NO-SUCH-ROLL", "quantity": 5 },
      "expectedStatus": 400
    },
    {
      "name": "Возврат на рулон без рулона запрещён",
      "method": "POST",
      "path": "/",
      "body": { "action": "packer_return", "quantity": 5, "goodsWarehouseId": 1 },
      "expectedStatus": 400
    },
    {
      "name": "Возврат отрицательного метража запрещён",
      "method": "POST",
      "path": "/",
      "body": { "action": "packer_return", "barcode": "QA-NO-SUCH-ROLL", "quantity": -5, "goodsWarehouseId": 1 },
      "expectedStatus": 400
    },
    {
      "name": "Перемещение рулона без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": { "action": "move_roll", "id": 1, "target": "storage", "reason": "тест" },
      "expectedStatus": 401
    },
    {
      "name": "Перемещение рулона чужим actorId не проходит",
      "method": "POST",
      "path": "/",
      "body": { "action": "move_roll", "id": 1, "target": "workshop", "workshopId": 1, "shiftNumber": 1, "reason": "подмена", "actorId": 1 },
      "expectedStatus": 401
    },
    {
      "name": "Неизвестное действие отклоняется",
      "method": "POST",
      "path": "/",
      "body": { "action": "nope" },
      "expectedStatus": 400
    }
  ]
}