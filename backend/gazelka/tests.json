{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Unknown action fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "nope"
      },
      "expectedStatus": 400
    },
    {
      "name": "GET not allowed",
      "method": "GET",
      "path": "/",
      "expectedStatus": 405
    },
    {
      "name": "Чужая поставка не найдена",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "list_plans",
        "supplyId": 999999999
      },
      "expectedStatus": 404
    }
  ]
}