{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get orders list",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Create manual order without data fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "create_manual"},
      "expectedStatus": 400
    },
    {
      "name": "Create manual order with duplicate number fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "create_manual", "orderNumber": "119956630-172", "marketplace": "OZON", "orderType": "FBO", "marketplaceItemId": 5},
      "expectedStatus": 409
    },
    {
      "name": "Take stack without userId fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "take_stack", "workshopId": 1},
      "expectedStatus": 400
    },
    {
      "name": "Cut without id fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "cut"},
      "expectedStatus": 400
    },
    {
      "name": "Take order without userId fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "take_order"},
      "expectedStatus": 400
    },
    {
      "name": "Send to stickering without rollId fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "send_to_stickering", "id": 1},
      "expectedStatus": 400
    },
    {
      "name": "Cancel order without id fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "cancel_order"},
      "expectedStatus": 400
    },
    {
      "name": "Cancel non-existent order fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "cancel_order", "id": 999999},
      "expectedStatus": 404
    }
  ]
}