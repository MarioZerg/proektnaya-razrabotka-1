{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get orders list",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Create manual order without data fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "create_manual"},
      "expectedStatus": 400
    },
    {
      "name": "Create manual order without item fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "create_manual", "marketplace": "OZON", "orderType": "FBO"},
      "expectedStatus": 400
    },
    {
      "name": "Take stack without userId fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "take_stack", "workshopId": 1},
      "expectedStatus": 400
    },
    {
      "name": "Take stack for workshop with no allowed materials fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "take_stack", "userId": 999999, "workshopId": 999999},
      "expectedStatus": 409
    },
    {
      "name": "Sewing waits for user without shift works",
      "method": "GET",
      "path": "/?sewingWaits=1&userId=999999",
      "expectedStatus": 200
    },
    {
      "name": "Cut without id fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "cut"},
      "expectedStatus": 400
    },
    {
      "name": "Take order without userId fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "take_order"},
      "expectedStatus": 400
    },
    {
      "name": "Send to stickering without id fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "send_to_stickering"},
      "expectedStatus": 400
    },
    {
      "name": "Send to stickering for non-existent order fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "send_to_stickering", "id": 999999},
      "expectedStatus": 404
    },
    {
      "name": "Cancel order without id fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "cancel_order"},
      "expectedStatus": 400
    },
    {
      "name": "Cancel non-existent order fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "cancel_order", "id": 999999},
      "expectedStatus": 404
    },
    {
      "name": "Bulk cancel preview without auth is rejected",
      "method": "POST",
      "path": "/",
      "body": {"action": "bulk_cancel_preview", "material": "Тюль"},
      "expectedStatus": 401
    },
    {
      "name": "Bulk cancel without auth is rejected",
      "method": "POST",
      "path": "/",
      "body": {"action": "bulk_cancel_orders", "orderIds": [999999]},
      "expectedStatus": 401
    },
    {
      "name": "Delete order without auth is rejected",
      "method": "POST",
      "path": "/",
      "body": {"action": "delete_order", "id": 999999},
      "expectedStatus": 401
    },
    {
      "name": "Restore order without auth is rejected",
      "method": "POST",
      "path": "/",
      "body": {"action": "restore_order", "id": 999999},
      "expectedStatus": 401
    },
    {
      "name": "Search orders by number works",
      "method": "GET",
      "path": "/?search=0000",
      "expectedStatus": 200
    },
    {
      "name": "Search with too short query returns empty",
      "method": "GET",
      "path": "/?search=1",
      "expectedStatus": 200
    }
  ]
}