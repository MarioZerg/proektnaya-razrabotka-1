{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Unknown action fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "nope"
      },
      "expectedStatus": 400
    },
    {
      "name": "Check returns status",
      "method": "GET",
      "path": "/?action=check",
      "expectedStatus": 200
    },
    {
      "name": "Sync via GET without cron key forbidden",
      "method": "GET",
      "path": "/?action=sync",
      "expectedStatus": 403
    },
    {
      "name": "Wrong cron key forbidden",
      "method": "GET",
      "path": "/?action=sync&cronSecret=wrong",
      "expectedStatus": 403
    }
  ]
}