{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get types and materials",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Packaging guide",
      "method": "GET",
      "path": "/?view=packaging",
      "expectedStatus": 200
    },
    {
      "name": "Создание материала без входа отклоняется",
