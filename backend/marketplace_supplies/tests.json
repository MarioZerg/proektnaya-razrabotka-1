{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get supplies list",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Create supply without marketplace fails",
      "method": "POST",
      "path": "/",
      "body": { "action": "create" },
      "expectedStatus": 400
    },
    {
      "name": "Create supply with invalid type fails",
      "method": "POST",
      "path": "/",
      "body": { "action": "create", "marketplace": "OZON", "type": "XYZ" },
      "expectedStatus": 400
    },
    {
      "name": "Move status without valid status fails",
      "method": "POST",
      "path": "/",
      "body": { "action": "move_status", "supplyId": 1, "status": "Не статус" },
      "expectedStatus": 400
    },
    {
      "name": "Scan order without supplyId fails",
      "method": "POST",
      "path": "/",
      "body": { "action": "scan_order", "orderNumber": "TEST-001" },
      "expectedStatus": 400
    }
  ]
}