{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Unknown action fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "nope"},
      "expectedStatus": 400
    },
    {
      "name": "GET not allowed",
      "method": "GET",
      "path": "/",
      "expectedStatus": 405
    },
    {
      "name": "Create supply without supplyId fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "create_supply"},
      "expectedStatus": 400
    },
    {
      "name": "Deliver supply without supplyId fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "deliver_supply"},
      "expectedStatus": 400
    }
  ]
}