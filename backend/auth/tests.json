{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Unknown action fails",
      "method": "POST",
      "path": "/",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Test accounts list",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "test_accounts"
      },
      "expectedStatus": 200
    },
    {
      "name": "Max verify code without code fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "max_verify_code"
      },
      "expectedStatus": 400
    },
    {
      "name": "Max verify code with unknown code fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "max_verify_code",
        "code": "000000"
      },
      "expectedStatus": 401
    },
    {
      "name": "Select role without data fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "select_role"
      },
      "expectedStatus": 400
    },
    {
      "name": "Enter role without data fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "enter_role"
      },
      "expectedStatus": 400
    },
    {
      "name": "Online now returns counters",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "online_now"
      },
      "expectedStatus": 200
    },
    {
      "name": "Impersonate without data fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "impersonate"
      },
      "expectedStatus": 400
    },
    {
      "name": "Impersonate by non-admin fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "impersonate",
        "adminId": 999999,
        "userId": 1
      },
      "expectedStatus": 403
    },
    {
      "name": "Password login disabled",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "password_login",
        "login": "admin",
        "password": "x"
      },
      "expectedStatus": 410
    },
    {
      "name": "Startup without userId fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "startup"
      },
      "expectedStatus": 400
    }
  ]
}