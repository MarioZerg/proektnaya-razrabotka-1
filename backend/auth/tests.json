{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Missing credentials",
      "method": "POST",
      "path": "/",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Wrong login",
      "method": "POST",
      "path": "/",
      "body": {"login": "no_such_user", "password": "whatever"},
      "expectedStatus": 401
    },
    {
      "name": "Test accounts list",
      "method": "POST",
      "path": "/",
      "body": {"action": "test_accounts"},
      "expectedStatus": 200
    },
    {
      "name": "Max send code without login fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "max_send_code"},
      "expectedStatus": 400
    },
    {
      "name": "Max send code for unknown login fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "max_send_code", "login": "no_such_user"},
      "expectedStatus": 404
    },
    {
      "name": "Max verify code without data fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "max_verify_code"},
      "expectedStatus": 400
    }
  ]
}