{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get shipments list",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Создание документа без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": { "action": "create" },
      "expectedStatus": 401
    },
    {
      "name": "Списание материала в цехе без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "workshop_writeoff",
        "workshopId": 1,
        "items": [{ "materialId": 1, "quantity": 100 }]
      },
      "expectedStatus": 401
    },
    {
      "name": "Чужой actorId в теле запроса не даёт списать материал",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "workshop_writeoff",
        "workshopId": 1,
        "actorId": 10,
        "actorName": "Администратор",
        "items": [{ "materialId": 1, "quantity": 100 }]
      },
      "expectedStatus": 401
    },
    {
      "name": "Подтверждение приёмки без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": { "action": "approve_supply", "id": 1 },
      "expectedStatus": 401
    },
    {
      "name": "Подтверждение приёмки без id отклоняется",
      "method": "POST",
      "path": "/",
      "body": { "action": "approve_supply" },
      "expectedStatus": 401
    },
    {
      "name": "Правка метража рулона без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": { "action": "update_roll_quantity", "itemId": 1, "quantity": 999, "actorId": 10 },
      "expectedStatus": 401
    },
    {
      "name": "Удаление документа без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": { "action": "delete", "id": 999999 },
      "expectedStatus": 401
    },
    {
      "name": "Reject receive without shipmentId fails",
      "method": "POST",
      "path": "/",
      "body": { "action": "reject_receive" },
      "expectedStatus": 400
    },
    {
      "name": "Reject receive without reason fails",
      "method": "POST",
      "path": "/",
      "body": { "action": "reject_receive", "shipmentId": 1 },
      "expectedStatus": 400
    }
  ]
}