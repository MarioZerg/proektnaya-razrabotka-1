{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get shipments list",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Create shipment without type fails",
      "method": "POST",
      "path": "/",
      "body": { "action": "create" },
      "expectedStatus": 400
    },
    {
      "name": "Delete without id fails",
      "method": "POST",
      "path": "/",
      "body": { "action": "delete" },
      "expectedStatus": 400
    },
    {
      "name": "Delete non-existing shipment fails",
      "method": "POST",
      "path": "/",
      "body": { "action": "delete", "id": 999999 },
      "expectedStatus": 404
    }
  ]
}