{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get available pieces",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Suitable without orderId fails",
      "method": "GET",
      "path": "/?action=suitable",
      "expectedStatus": 400
    },
    {
      "name": "Suitable for missing order",
      "method": "GET",
      "path": "/?action=suitable&orderId=999999999",
      "expectedStatus": 404
    },
    {
      "name": "Unknown action fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "nope"},
      "expectedStatus": 400
    },
    {
      "name": "Send without goods id fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "send"},
      "expectedStatus": 400
    },
    {
      "name": "Reasons list available",
      "method": "GET",
      "path": "/?action=reasons",
      "expectedStatus": 200
    },
    {
      "name": "Send without reason fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "send", "goodsWarehouseId": 999999999},
      "expectedStatus": 400
    },
    {
      "name": "Use without piece fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "use", "orderId": 1},
      "expectedStatus": 400
    },
    {
      "name": "Use missing piece fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "use", "pieceId": 999999999, "orderId": 999999999},
      "expectedStatus": 404
    },
    {
      "name": "Reserved without orderId fails",
      "method": "GET",
      "path": "/?action=reserved",
      "expectedStatus": 400
    },
    {
      "name": "Reserved for order without piece returns null",
      "method": "GET",
      "path": "/?action=reserved&orderId=999999999",
      "expectedStatus": 200
    },
    {
      "name": "Release without ids fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "release"},
      "expectedStatus": 400
    },
    {
      "name": "Release of non-reserved order fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "release", "orderId": 999999999},
      "expectedStatus": 404
    },
    {
      "name": "Delete without auth is rejected",
      "method": "POST",
      "path": "/",
      "body": {"action": "delete", "pieceId": 1},
      "expectedStatus": 401
    },
    {
      "name": "Delete without piece id fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "delete"},
      "expectedStatus": 400
    },
    {
      "name": "Write off without auth is rejected",
      "method": "POST",
      "path": "/",
      "body": {"action": "write_off", "pieceId": 1},
      "expectedStatus": 401
    },
    {
      "name": "PUT not allowed",
      "method": "PUT",
      "path": "/",
      "expectedStatus": 405
    }
  ]
}