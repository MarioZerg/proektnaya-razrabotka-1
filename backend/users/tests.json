{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get users list",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Create user without data fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "create"
      },
      "expectedStatus": 400
    },
    {
      "name": "Create user with invalid role fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "create",
        "fullName": "Тест Тестов",
        "email": "test@example.com",
        "role": "unknown",
        "password": "12345678"
      },
      "expectedStatus": 400
    },
    {
      "name": "Add role without data fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "add_role"
      },
      "expectedStatus": 400
    },
    {
      "name": "Approve role without data fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "approve_role"
      },
      "expectedStatus": 400
    },
    {
      "name": "Remove role without data fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "remove_role"
      },
      "expectedStatus": 400
    },
    {
      "name": "Delete without id fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "delete"
      },
      "expectedStatus": 400
    },
    {
      "name": "Delete user with work history fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "delete",
        "id": 20
      },
      "expectedStatus": 409
    }
  ]
}