{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get users list",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Create user without data fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "create"
      },
      "expectedStatus": 400
    },
    {
      "name": "Create user with invalid role fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "create",
        "fullName": "Тест Тестов",
        "email": "test@example.com",
        "role": "unknown",
        "password": "12345678"
      },
      "expectedStatus": 400
    },
    {
      "name": "Add role without data fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "add_role"
      },
      "expectedStatus": 400
    },
    {
      "name": "Approve role without data fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "approve_role"
      },
      "expectedStatus": 400
    },
    {
      "name": "Remove role without data fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "remove_role"
      },
      "expectedStatus": 400
    },
    {
      "name": "Delete without id fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "delete"
      },
      "expectedStatus": 400
    },
    {
      "name": "Delete user with work history fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "delete",
        "id": 20
      },
      "expectedStatus": 409
    },
    {
      "name": "Chat: get messages",
      "method": "GET",
      "path": "/?chat=1",
      "expectedStatus": 200
    },
    {
      "name": "Chat: poll since id",
      "method": "GET",
      "path": "/?chat=1&since=0",
      "expectedStatus": 200
    },
    {
      "name": "Chat: send without text fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "chat_send",
        "userId": 1
      },
      "expectedStatus": 400
    },
    {
      "name": "Chat: hide without id fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "chat_hide",
        "actorId": 1
      },
      "expectedStatus": 400
    },
    {
      "name": "Archive without id fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "archive"
      },
      "expectedStatus": 400
    },
    {
      "name": "Unarchive without id fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "unarchive"
      },
      "expectedStatus": 400
    }
  ]
}