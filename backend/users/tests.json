{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get users list",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Создание сотрудника без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "create"
      },
      "expectedStatus": 401
    },
    {
      "name": "Нельзя завести себе аккаунт администратора без входа",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "create",
        "fullName": "Взлом Взломов",
        "email": "hack@example.com",
        "role": "admin",
        "password": "12345678"
      },
      "expectedStatus": 401
    },
    {
      "name": "Выдача роли без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "add_role"
      },
      "expectedStatus": 401
    },
    {
      "name": "Утверждение роли без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "approve_role"
      },
      "expectedStatus": 401
    },
    {
      "name": "Снятие роли без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "remove_role"
      },
      "expectedStatus": 401
    },
    {
      "name": "Удаление сотрудника без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "delete"
      },
      "expectedStatus": 401
    },
    {
      "name": "Роль admin в теле запроса больше не даёт прав",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "unlock_salary",
        "id": 20,
        "actorRole": "admin"
      },
      "expectedStatus": 401
    },
    {
      "name": "Увольнение без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "archive"
      },
      "expectedStatus": 401
    },
    {
      "name": "Возврат из архива без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "unarchive"
      },
      "expectedStatus": 401
    },
    {
      "name": "Пустой POST от Авито отвечает 200",
      "method": "POST",
      "path": "/",
      "body": {},
      "expectedStatus": 200
    },
    {
      "name": "Чаты кандидатов без админа закрыты",
      "method": "GET",
      "path": "/?candidateChats=1",
      "expectedStatus": 401
    },
    {
      "name": "Диалог кандидата без админа закрыт",
      "method": "GET",
      "path": "/?candidateChat=1&live=0",
      "expectedStatus": 401
    },
    {
      "name": "Синхронизация Авито без админа закрыта",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "candidate_chats_sync"
      },
      "expectedStatus": 401
    },
    {
      "name": "Ответ кандидату без админа закрыт",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "candidate_chat_send",
        "chatId": 1,
        "text": "x"
      },
      "expectedStatus": 401
    },
    {
      "name": "Статус кандидата без админа закрыт",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "candidate_chat_status",
        "chatId": 1,
        "status": "selected"
      },
      "expectedStatus": 401
    }
  ]
}