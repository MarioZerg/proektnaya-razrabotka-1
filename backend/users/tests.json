{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get users list",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Создание сотрудника без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "create"
      },
      "expectedStatus": 401
    },
    {
      "name": "Нельзя завести себе аккаунт администратора без входа",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "create",
        "fullName": "Взлом Взломов",
        "email": "hack@example.com",
        "role": "admin",
        "password": "12345678"
      },
      "expectedStatus": 401
    },
    {
      "name": "Выдача роли без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "add_role"
      },
      "expectedStatus": 401
    },
    {
      "name": "Утверждение роли без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "approve_role"
      },
      "expectedStatus": 401
    },
    {
      "name": "Снятие роли без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "remove_role"
      },
      "expectedStatus": 401
    },
    {
      "name": "Удаление сотрудника без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "delete"
      },
      "expectedStatus": 401
    },
    {
      "name": "Роль admin в теле запроса больше не даёт прав",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "unlock_salary",
        "id": 20,
        "actorRole": "admin"
      },
      "expectedStatus": 401
    },
    {
      "name": "Chat: get messages",
      "method": "GET",
      "path": "/?chat=1",
      "expectedStatus": 200
    },
    {
      "name": "Chat: poll since id",
      "method": "GET",
      "path": "/?chat=1&since=0",
      "expectedStatus": 200
    },
    {
      "name": "Chat: нельзя написать от чужого имени без входа",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "chat_send",
        "userId": 1,
        "text": "Привет от чужого имени"
      },
      "expectedStatus": 401
    },
    {
      "name": "Chat: удаление сообщения без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "chat_hide",
        "id": 1,
        "actorId": 1
      },
      "expectedStatus": 401
    },
    {
      "name": "Chat: нельзя подменить чужое фото без входа",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "chat_avatar",
        "id": 1,
        "avatarBase64": "data:image/png;base64,iVBORw0KGgo="
      },
      "expectedStatus": 401
    },
    {
      "name": "Увольнение без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "archive"
      },
      "expectedStatus": 401
    },
    {
      "name": "Возврат из архива без входа отклоняется",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "unarchive"
      },
      "expectedStatus": 401
    }
  ]
}
