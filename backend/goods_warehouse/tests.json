{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get goods warehouse list",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Place on shelf without barcode fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "place_on_shelf"
      },
      "expectedStatus": 400
    },
    {
      "name": "Ship label without barcode fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "ship_label"
      },
      "expectedStatus": 400
    },
    {
      "name": "Receive return without orderNumber fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "receive_return"
      },
      "expectedStatus": 400
    },
    {
      "name": "Pending count for storekeeper",
      "method": "GET",
      "path": "/?pending_count=1",
      "expectedStatus": 200
    },
    {
      "name": "Rematch stock runs",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "rematch_stock"
      },
      "expectedStatus": 200
    },
    {
      "name": "Send to sewing without id fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "send_to_sewing"
      },
      "expectedStatus": 400
    },
    {
      "name": "Send to sewing without reason fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "send_to_sewing",
        "id": 999999
      },
      "expectedStatus": 400
    },
    {
      "name": "Send to sewing for missing item fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "send_to_sewing",
        "id": 999999,
        "reason": "порвана"
      },
      "expectedStatus": 404
    },
    {
      "name": "To shelf from inspection without ids fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "to_shelf_from_inspection"
      },
      "expectedStatus": 400
    },
    {
      "name": "Find item by code without code fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "find_item_by_code"
      },
      "expectedStatus": 400
    },
    {
      "name": "Find item by unknown code returns 404",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "find_item_by_code",
        "code": "NOPE-XXX-000"
      },
      "expectedStatus": 404
    },
    {
      "name": "Not found without id fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "not_found"
      },
      "expectedStatus": 400
    },
    {
      "name": "Not found without rights fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "not_found",
        "id": 999999,
        "actorId": 0
      },
      "expectedStatus": 403
    },
    {
      "name": "Restore lost without id fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "restore_lost"
      },
      "expectedStatus": 400
    },
    {
      "name": "Restore lost without admin fails",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "restore_lost",
        "id": 999999,
        "actorId": 0
      },
      "expectedStatus": 403
    }
  ]
}