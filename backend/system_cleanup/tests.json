{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Preview shows what will be deleted",
      "method": "POST",
      "path": "/",
      "body": {"action": "preview"},
      "expectedStatus": 200
    },
    {
      "name": "Cleanup without confirm phrase fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "cleanup"},
      "expectedStatus": 400
    },
    {
      "name": "Cleanup with wrong confirm phrase fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "cleanup", "confirm": "yes"},
      "expectedStatus": 400
    },
    {
      "name": "Unknown action fails",
      "method": "POST",
      "path": "/",
      "body": {"action": "nope"},
      "expectedStatus": 400
    },
    {
      "name": "GET not allowed",
      "method": "GET",
      "path": "/",
      "expectedStatus": 405
    }
  ]
}
