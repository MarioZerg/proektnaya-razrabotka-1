{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Status without admin forbidden",
      "method": "GET",
      "path": "/?action=status",
      "expectedStatus": 403
    },
    {
      "name": "Unknown GET action fails",
      "method": "GET",
      "path": "/?action=nope",
      "expectedStatus": 400
    },
    {
      "name": "Run without admin or secret forbidden",
      "method": "POST",
      "path": "/",
      "body": {"action": "run"},
      "expectedStatus": 403
    },
    {
      "name": "Save without admin forbidden",
      "method": "POST",
      "path": "/",
      "body": {"action": "save", "stepPercent": 0.5},
      "expectedStatus": 403
    }
  ]
}
